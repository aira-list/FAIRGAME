# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# ---- Provider API keys -------------------------------------------------
# LiteLLM reads the provider-standard variable names. Set only the ones you
# use; locally-served models (e.g. Ollama) need no key.
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
MISTRAL_API_KEY=your-mistral-key
DEEPSEEK_API_KEY=your-deepseek-key

# ---- Optional: engine tuning ------------------------------------------
# FAIRGAME_LLM_MAX_TOKENS=1024
# FAIRGAME_LLM_MIN_INTERVAL=0.0
# FAIRGAME_TRANSLATOR_MODEL=OpenAIGPT4o

# ---- Optional: web app -------------------------------------------------
# Location of CLI/paper example configs (the web app does not need this):
# FAIRGAME_RESOURCES_DIR=../Fairgame_paper_evaluations/resources
# Public community/showcase URL. When set, the SPA shows "community" links;
# when empty (default) those links are hidden.
# FAIRGAME_COMMUNITY_URL=https://your-fairgame-community.example.org
